# Discord bot token (Developer Portal -> Your App -> Bot -> Reset Token)
DISCORD_TOKEN=

# Application ID (Developer Portal -> Your App -> General Information -> Application ID)
CLIENT_ID=

# Your development / production guild (server) ID.
# Used to register slash commands instantly during development.
GUILD_ID=

# Optional: path to the SQLite database file (default: ./data/nekrobro.db)
DATABASE_PATH=

# Optional: log level -> error | warn | info | debug (default: info)
LOG_LEVEL=info
